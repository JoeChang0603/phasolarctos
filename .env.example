VITE_GOOGLE_MAPS_STATIC_API_KEY=google_maps_static_api_key
# Cloudflare Worker endpoint for manually adding expenses to Notion.
VITE_EXPENSE_API_URL=https://phasolarctos-expense-api.ftravel.workers.dev
